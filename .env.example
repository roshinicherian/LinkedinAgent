# ============================================================
# LinkedIn Thought-Leadership Agent — environment template
# Copy to .env and fill in.  .env is gitignored. NEVER commit it.
#
# In Claude Code Remote, set these as ENVIRONMENT VARIABLES on the
# environment instead of committing a file — a fresh cloud session
# clones the repo but will NOT have your local .env.
# ============================================================

# --- Publora (publishing) ---
PUBLORA_API_KEY=
PUBLORA_BASE_URL=https://api.publora.com
# The ONLY source of truth for the publish target. Personal profile ID.
# Never accepted from a prompt, a file, or a previous post.
LINKEDIN_PLATFORM_ID=

# --- Pixfaro (illustrations) ---
PIXFARO_TOKEN=
PIXFARO_BASE_URL=https://api.pixfaro.com
# Cheap default. Premium models require explicit per-run approval.
PIXFARO_DEFAULT_MODEL=flux-schnell

# --- Approval email ---
APPROVAL_EMAIL=roshini30@gmail.com
APPROVAL_FROM=
# Only replies from this exact envelope sender are honoured.
APPROVAL_ALLOWED_SENDER=roshini30@gmail.com

# --- SMTP (sending) ---
# Gmail: smtp.gmail.com / 587 / an App Password (not your login password)
# Elastic Email: smtp.elasticemail.com / 2525
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- IMAP (reading your reply) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Schedule (AEST/AEDT, Australia/Sydney) ---
# Draft email goes out Wednesday night; post publishes Thursday morning.
TIMEZONE=Australia/Sydney
INPUT_REQUEST_CRON_LOCAL=Tue 08:10
DRAFT_EMAIL_LOCAL=Wed 20:00
REMINDER_LOCAL=Thu 06:00
APPROVAL_CUTOFF_LOCAL=Thu 06:30
PUBLISH_LOCAL=Thu 07:45
